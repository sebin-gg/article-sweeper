  "redirect": {
    "path_pattern": "/(url|redirect|redir|r|l|click|track/click|CL0|lmu\\w*)(/|$|\\?)",
    "query_params": [
      "u",
      "url",
      "redirect",
      "dest",
      "destination",
      "to"
    ]
  },
