  "article_hints": {
    "path_pattern": "(/blog/|/blogs/|/news/|/articles?/|/posts?/|/stories?/|/docs?/|/tutorials?/|/guides?/|/papers?/|/releases?/|/changelog|/wiki/|/20\\d\\d/\\d\\d/|/p/|/story/|/essays?/)",
    "flags": [
      "IGNORECASE"
    ]
  },
  "non_article": {
    "segments": [
